# Copy this file to `.env` in the project root before running
# `docker compose up`. Docker Compose reads this file both to
# substitute ${VARS} inside docker-compose.yml and to inject the same
# variables into each container's environment.
#
# Hostnames below (postgres, redis) resolve inside the Docker network.
# Running the backend outside Docker against these same services?
# Swap them for localhost.

# --- Core ---
APP_ENV=development
APP_NAME=Threshold
SECRET_KEY=dev-secret-change-me-please-generate-32-bytes
# In staging/production these must be strong random secrets (>=32 chars).
# For anything beyond throwaway local dev, generate a real one:
#   openssl rand -hex 32
API_V1_PREFIX=/api/v1

# --- Postgres ---
POSTGRES_USER=threshold
POSTGRES_PASSWORD=threshold_dev_password
POSTGRES_DB=threshold
DATABASE_URL=postgresql+psycopg://threshold:threshold_dev_password@postgres:5432/threshold

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- AI providers ---
# "mock" needs no API key and is what demo mode uses by default.
# Set AI_PROVIDER=openai or AI_PROVIDER=anthropic with the corresponding API key for live provider-backed execution.
AI_PROVIDER=mock
# Optional model override; required for Anthropic with the default seeded prompts.
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Webhooks ---
WEBHOOK_SIGNING_SECRET=dev-webhook-secret-change-me-please-generate-32-bytes

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Live integration safety ---
# Comma-separated exact hosts that outbound integration adapters may contact.
# Required before configuring a live Generic REST provider.
INTEGRATION_ALLOWED_HOSTS=api.example.com
# Credential values are injected outside the database. Example when the
# workspace stores credential_ref=ACME_REFUND_API:
THRESHOLD_INTEGRATION_SECRET__ACME_REFUND_API=

# --- Durable delivery / recovery ---
OUTBOX_LEASE_SECONDS=60
OUTBOX_BATCH_SIZE=100
EVENT_PROCESSING_LEASE_SECONDS=300
ACTION_EXECUTION_LEASE_SECONDS=120

# Tenant webhook secrets use references stored in webhook_endpoints. Example:
# signing_secret_ref=SHOPIFY_WEBHOOK resolves this deployment secret:
THRESHOLD_WEBHOOK_SECRET__SHOPIFY_WEBHOOK=

# Milestone 5 ecommerce provider secrets (examples only; never commit real values)
# THRESHOLD_INTEGRATION_SECRET__SHOPIFY_ADMIN=shpat_...
# THRESHOLD_WEBHOOK_SECRET__SHOPIFY_WEBHOOK=...
# THRESHOLD_INTEGRATION_SECRET__STRIPE_SECRET=sk_test_...
# For live ecommerce adapters, allowlist the exact outbound hosts, e.g.
# INTEGRATION_ALLOWED_HOSTS=merchant.myshopify.com,api.stripe.com

# --- Milestone 6 commercialization ---
PUBLIC_APP_URL=http://localhost:5173
BILLING_STRIPE_SECRET_REF=
BILLING_STRIPE_WEBHOOK_SECRET_REF=
STRIPE_STARTER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,read_customers,write_orders
SHOPIFY_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/commercial/shopify/callback
SHOPIFY_API_VERSION=2026-07

# Server-to-server secret vault handoff. Threshold refuses Shopify OAuth
# token exchange unless this is configured, so merchant tokens are never
# written raw to the application database.
OAUTH_SECRET_SINK_URL=
OAUTH_SECRET_SINK_AUTH_REF=

# --- Milestone 7 production hardening ---
JWT_ISSUER=threshold
JWT_AUDIENCE=threshold-api
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
# Set true only when backend traffic comes exclusively from the supplied trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Private-beta evidence declarations. Set these only after the evidence exists.
BETA_ALLOW_MOCK_AI=false
BETA_LAST_RESTORE_DRILL_AT=
BETA_MAX_RESTORE_DRILL_AGE_DAYS=30
BETA_ALERTING_CONFIGURED=false
BETA_ONCALL_OWNER=
