{
  "name": "Threshold \u2014 01_submit_refund",
  "nodes": [
    {
      "parameters": {},
      "id": "bbd3eaaa-e911-567f-9ddc-523aabbe3fce",
      "name": "Manual Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Edit only these non-secret values. Use one dedicated test ticket per request.\nconst config = {\n  threshold_url: 'REPLACE_WITH_THRESHOLD_WEBHOOK_URL',\n  portal_id: 'REPLACE_WITH_HUBSPOT_PORTAL_ID',\n  ticket_id: 'REPLACE_WITH_EXISTING_TEST_TICKET_ID',\n  text: 'Refund order #ORD-1002 for $65.00',\n  sender: 'ana.bootcamp@example.com'\n};\nif (!/^https:\\/\\//.test(config.threshold_url)) throw new Error('Configure an HTTPS Threshold URL reachable from n8n Cloud');\nfor (const key of ['portal_id','ticket_id']) if (!/^[0-9]{1,32}$/.test(config[key])) throw new Error('Configure ' + key);\nconst event_id = 'hubspot:' + config.portal_id + ':ticket:' + config.ticket_id;\nconst payload = {text: config.text, sender: config.sender, external_id: event_id,\n  crm: {provider:'hubspot', portal_id:config.portal_id, ticket_id:config.ticket_id}};\nconst raw_body = JSON.stringify(payload);\nconst timestamp = String(Math.floor(Date.now()/1000));\nreturn [{json: {url:config.threshold_url, event_id, raw_body, timestamp,\n  signed_text:timestamp + '.' + raw_body}}];"
      },
      "id": "18522211-57f7-51ae-94ed-c1486419c3a2",
      "name": "Demo Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.signed_text }}",
        "dataPropertyName": "signature",
        "encoding": "hex",
        "binaryData": false
      },
      "id": "7c2dd885-b105-5dc4-869a-b4096aa47563",
      "name": "Sign Intake",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Threshold-Event-Id",
              "value": "={{ $json.event_id }}"
            },
            {
              "name": "X-Threshold-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-Threshold-Signature",
              "value": "={{ \"sha256=\" + $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.raw_body }}",
        "options": {
          "timeout": 10000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "f465a2fb-d8a5-50de-b2c7-8e40e4d82550",
      "name": "Submit to Threshold",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "if ($json.statusCode !== 202 || $json.body?.accepted !== true) {\n throw new Error('Threshold intake failed: HTTP ' + $json.statusCode + '. Check configuration or EVENT_ID_CONFLICT.');\n}\nreturn [{json:{accepted:true, duplicate:$json.body.duplicate,\n event_id:$json.body.event_id, message:'Accepted for processing. This is not a refund success confirmation.'}}];"
      },
      "id": "0bea42bc-f21f-5fec-97dd-0d0cbd3e67fb",
      "name": "Check Acceptance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    }
  ],
  "connections": {
    "Manual Start": {
      "main": [
        [
          {
            "node": "Demo Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Demo Request": {
      "main": [
        [
          {
            "node": "Sign Intake",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign Intake": {
      "main": [
        [
          {
            "node": "Submit to Threshold",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit to Threshold": {
      "main": [
        [
          {
            "node": "Check Acceptance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
